# Copy this file to airflow/.env. Do not commit the copy.

# Run 'id -u' on Linux/macOS and put the result here.
# It keeps the host-mounted data/raw directory writable from containers.
AIRFLOW_UID=1000

# Local PostgreSQL used only for Airflow metadata.
AIRFLOW_METADATA_DB_PASSWORD=replace-with-a-strong-local-password

# Credentials for the Airflow web interface.
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AIRFLOW_ADMIN_FIRSTNAME=Airlines
AIRFLOW_ADMIN_LASTNAME=Administrator
AIRFLOW_ADMIN_EMAIL=airflow@example.invalid

# Required persistent Airflow secrets.
AIRFLOW_FERNET_KEY=replace-with-a-generated-fernet-key
AIRFLOW_JWT_SECRET=replace-with-a-random-jwt-secret

# Browser port on the host machine.
AIRFLOW_WEB_PORT=8080